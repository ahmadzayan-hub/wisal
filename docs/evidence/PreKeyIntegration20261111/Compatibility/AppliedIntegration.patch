+        assertEquals(PreKeyMaintenanceAction.CURRENT, f.coordinator().runOnce(f.identity).getOrThrow().action)
+        f.now++
+        assertEquals(2, f.coordinator().runOnce(f.identity).getOrThrow().oneTimePreKeyId)
+        val snapshot = Json.parseToJsonElement(f.disk.value!!).jsonObject
+        for (key in listOf("preKeys", "signedKeys", "kyberKeys")) {
+            assertEquals(setOf("1", "2"), snapshot.getValue(key).jsonObject.keys)
+        }
+    }
+
+    @Test fun unknownLegacyRemoteBundleIsNotAdoptedOrOverwritten() = runBlocking {
+        val f = Fixture()
+        val legacy = f.provider.nextPublishableBundle("B", f.now)
+        f.relay.bundle = legacy
+        f.relay.available = true
+        f.relay.publicationTime = f.now
+        val stable = f.disk.value
+        assertTrue(f.coordinator().runOnce(f.identity).exceptionOrNull() is PreKeyPublicationConflictException)
+        assertEquals(stable, f.disk.value)
+        assertEquals(0, f.relay.publishCalls)
+        assertNull(f.state().accepted)
+    }
+
+    @Test fun missingOrMismatchedAcceptedRelayStateCannotTriggerBlindReplacement() = runBlocking {
+        val f = Fixture()
+        f.coordinator().runOnce(f.identity).getOrThrow()
+        val accepted = f.relay.bundle!!
+        val stable = f.disk.value
+        f.relay.bundle = null
+        f.relay.available = false
+        assertTrue(f.coordinator().runOnce(f.identity).exceptionOrNull() is PreKeyPublicationConflictException)
+        f.relay.bundle = accepted.copy(signedPreKeyId = accepted.signedPreKeyId + 1)
+        assertTrue(f.coordinator().runOnce(f.identity).exceptionOrNull() is PreKeyPublicationConflictException)
+        assertEquals(1, f.relay.publishCalls)
+        assertEquals(stable, f.disk.value)
+    }
+
+    @Test fun unknownRemoteStateDoesNotCausePendingBundleResendOrAcknowledgement() = runBlocking {
+        val f = Fixture()
+        f.relay.publishFailureBefore = IOException("synthetic offline")
+        assertTrue(f.coordinator().runOnce(f.identity).isFailure)
+        val pending = f.state().pending!!
+        f.relay.bundle = pending.bundle.copy(oneTimePreKeyId = pending.bundle.oneTimePreKeyId + 10)
+        f.relay.available = true
+        f.relay.publicationTime = f.now
+        f.relay.publishFailureBefore = null
+        assertTrue(f.coordinator(f.disk.open()).runOnce(f.identity).exceptionOrNull() is PreKeyPublicationConflictException)
+        assertEquals(pending, f.state().pending)
+        assertNull(f.state().accepted)
+        assertEquals(1, f.relay.publishCalls)
+        assertEquals(1, f.disk.highestId())
+    }
+
+    @Test fun knownPriorAcceptedPublicationPermitsResumingNewPendingPublication() = runBlocking {
+        val f = Fixture()
+        f.coordinator().runOnce(f.identity).getOrThrow()
+        f.relay.available = false
+        f.relay.publishFailureBefore = IOException("synthetic offline on second key")
+        assertTrue(f.coordinator().runOnce(f.identity).isFailure)
+        assertEquals(1, f.relay.bundle!!.oneTimePreKeyId)
+        assertEquals(2, f.state().pending!!.bundle.oneTimePreKeyId)
+        f.relay.publishFailureBefore = null
+        assertEquals(2, f.coordinator(f.disk.open()).runOnce(f.identity).getOrThrow().oneTimePreKeyId)
+        assertEquals(listOf(1, 2, 2), f.relay.attempts.map { it.oneTimePreKeyId })
+        assertEquals(2, f.disk.highestId())
+    }
+
+    @Test fun retainedOldPrivateMaterialDecryptsDelayedMessageAfterRelayReplenishment() = runBlocking {
+        val f = Fixture()
+        f.coordinator().runOnce(f.identity).getOrThrow()
+        val old = f.relay.bundle!!
+        val aliceIdentity = DeviceIdentityCodec.generate().copy(deviceId = "A")
+        val alice = LibsignalCryptoProvider(LibsignalKeys.generateIdentity())
+        val aliceBundle = alice.publishableBundle("A")
+        alice.trustPeer(f.identity.public, old, SignalPeerBinding.sign(f.identity, old))
+        alice.establishSession("B", Json.encodeToString(SignalPreKeyBundleDto.serializer(), old).toByteArray())
+        val delayed = alice.session("B").encrypt("synthetic delayed message".toByteArray())
+        f.relay.available = false
+        f.coordinator().runOnce(f.identity).getOrThrow()
+        val reopened = f.disk.open()
+        reopened.trustPeer(aliceIdentity.public, aliceBundle, SignalPeerBinding.sign(aliceIdentity, aliceBundle))
+        assertEquals("synthetic delayed message", String(reopened.session("A").decrypt(delayed)))
+        f.relay.available = false
+        assertEquals(3, f.coordinator(f.disk.open()).runOnce(f.identity).getOrThrow().oneTimePreKeyId)
+        assertEquals(listOf(1, 2, 3), f.relay.attempts.map { it.oneTimePreKeyId })
+    }
+}
diff --git a/android-wife-assistant/app/src/test/java/com/wifeassistant/PreKeyPublicationPersistenceTest.kt b/android-wife-assistant/app/src/test/java/com/wifeassistant/PreKeyPublicationPersistenceTest.kt
new file mode 100644
index 0000000..b4f5e7a
--- /dev/null
+++ b/android-wife-assistant/app/src/test/java/com/wifeassistant/PreKeyPublicationPersistenceTest.kt
@@ -0,0 +1,139 @@
+package com.wifeassistant
+
+import com.wifeassistant.data.crypto.*
+import kotlinx.serialization.json.*
+import org.junit.Assert.*
+import org.junit.Test
+
+class PreKeyPublicationPersistenceTest {
+    private val owner = DeviceIdentityCodec.generate()
+    private val scope = "https://relay.example.test"
+    private class Disk {
+        var text: String? = null
+        var writes = 0
+        var failure = ""
+        fun open(owner: String) = LibsignalCryptoProvider(SignalStatePersistence({ text }, {
+            writes++
+            if (failure == "before") error("synthetic private disk detail")
+            if (failure != "no-op") text = it
+            if (failure == "after") error("synthetic private disk detail")
+        }, owner))
+    }
+    private fun prepare(provider: LibsignalCryptoProvider, accepted: PreparedPreKeyPublication? = null, time: Long = 1_800_000_000L) =
+        provider.preparePreKeyPublication(owner.deviceId, time, scope, owner.publicKeyB64, accepted)
+
+    @Test fun keysCountersAndPendingIntentShareOneVerifiedWriteAndSurviveReopen() {
+        val disk = Disk()
+        val pending = prepare(disk.open(owner.deviceId))
+        assertEquals(1, disk.writes)
+        val reopened = disk.open(owner.deviceId).preKeyPublicationState(owner.deviceId)
+        assertEquals(pending, reopened.pending)
+        assertNull(reopened.accepted)
+        assertTrue(reopened.pendingOneTimeKeyPresent)
+        val snapshot = Json.parseToJsonElement(disk.text!!).jsonObject
+        for (field in listOf("preKeys", "signedKeys", "kyberKeys")) assertEquals(1, snapshot.getValue(field).jsonObject.size)
+        for (field in listOf("highestPreKeyId", "highestSignedId", "highestKyberId")) assertEquals(1, snapshot.getValue(field).jsonPrimitive.int)
+        assertFalse(disk.open(owner.deviceId).mayClaimE2ee)
+    }
+
+    @Test fun retriesReturnExactPersistedBundleWithoutGeneratingOrWritingAgain() {
+        val disk = Disk()
+        val first = prepare(disk.open(owner.deviceId))
+        repeat(4) { assertEquals(first, prepare(disk.open(owner.deviceId), time = 1_800_000_100L + it)) }
+        assertEquals(1, disk.writes)
+        assertTrue(runCatching { disk.open(owner.deviceId).nextPublishableBundle(owner.deviceId) }.isFailure)
+    }
+
+    @Test fun acceptedJournalAndNewPendingUseIndependentDurableHighWaterMarks() {
+        val disk = Disk()
+        val provider = disk.open(owner.deviceId)
+        provider.publishableBundle(owner.deviceId, 7, 11, 19)
+        val first = prepare(provider)
+        assertEquals(Triple(8, 12, 20), Triple(first.bundle.signedPreKeyId, first.bundle.kyberPreKeyId, first.bundle.oneTimePreKeyId))
+        provider.acceptPreKeyPublication(owner.deviceId, first)
+        val second = prepare(disk.open(owner.deviceId), first, 1_800_000_100L)
+        assertEquals(21, second.bundle.oneTimePreKeyId)
+        assertEquals(first, disk.open(owner.deviceId).preKeyPublicationState(owner.deviceId).accepted)
+        assertEquals(second, disk.open(owner.deviceId).preKeyPublicationState(owner.deviceId).pending)
+    }
+
+    @Test fun beforeWriteAndSilentNoOpFailuresReleaseNoBundleAndBlockSameProvider() {
+        for (mode in listOf("before", "no-op")) {
+            val disk = Disk(); val provider = disk.open(owner.deviceId)
+            disk.failure = mode
+            val failure = runCatching { prepare(provider) }.exceptionOrNull()!!
+            assertFalse(failure.toString().contains("private disk detail"))
+            assertNull(failure.cause)
+            assertNull(disk.text)
+            disk.failure = ""
+            assertTrue(runCatching { prepare(provider) }.isFailure)
+            assertEquals(1, prepare(disk.open(owner.deviceId)).bundle.oneTimePreKeyId)
+        }
+    }
+
+    @Test fun ambiguousWritePreservesExactPendingOnRestartWithoutReusingAnId() {
+        val disk = Disk(); val provider = disk.open(owner.deviceId)
+        disk.failure = "after"
+        assertTrue(runCatching { prepare(provider) }.isFailure)
+        disk.failure = ""
+        assertTrue(runCatching { prepare(provider) }.isFailure)
+        val recovered = disk.open(owner.deviceId)
+        val pending = recovered.preKeyPublicationState(owner.deviceId).pending!!
+        assertEquals(pending, prepare(recovered))
+        recovered.acceptPreKeyPublication(owner.deviceId, pending)
+        assertEquals(2, prepare(recovered, pending, 1_800_000_001L).bundle.oneTimePreKeyId)
+    }
+
+    @Test fun acknowledgementWriteFailureDoesNotPretendAcceptance() {
+        val disk = Disk(); val provider = disk.open(owner.deviceId)
+        val pending = prepare(provider)
+        val stable = disk.text
+        disk.failure = "before"
+        assertTrue(runCatching { provider.acceptPreKeyPublication(owner.deviceId, pending) }.isFailure)
+        assertEquals(stable, disk.text)
+        disk.failure = ""
+        assertTrue(runCatching { provider.acceptPreKeyPublication(owner.deviceId, pending) }.isFailure)
+        val reopened = disk.open(owner.deviceId)
+        assertEquals(pending, reopened.preKeyPublicationState(owner.deviceId).pending)
+        reopened.acceptPreKeyPublication(owner.deviceId, pending)
+        assertNull(reopened.preKeyPublicationState(owner.deviceId).pending)
+        assertEquals(pending, reopened.preKeyPublicationState(owner.deviceId).accepted)
+    }
+
+    @Test fun mismatchedReceiptScopeOwnerAndEphemeralProviderCannotChangeJournal() {
+        val disk = Disk(); val provider = disk.open(owner.deviceId)
+        val pending = prepare(provider)
+        val stable = disk.text
+        assertTrue(runCatching { provider.acceptPreKeyPublication(owner.deviceId, pending.copy(relayScope = "https://different.test")) }.isFailure)
+        assertTrue(runCatching { provider.preparePreKeyPublication(owner.deviceId, 1_800_000_001L, "https://different.test", owner.publicKeyB64, null) }.isFailure)
+        assertTrue(runCatching { provider.preKeyPublicationState("wrong") }.isFailure)
+        assertEquals(stable, disk.text)
+        assertTrue(runCatching { prepare(LibsignalCryptoProvider(LibsignalKeys.generateIdentity())) }.isFailure)
+    }
+
+    @Test fun corruptedPublicIntentCannotOutliveItsPrivateKeyOrSignature() {
+        for (field in listOf("oneTimePreKeyPublicB64", "signedPreKeyPublicB64", "signedPreKeySignatureB64", "kyberPreKeyPublicB64", "kyberPreKeySignatureB64", "identityKeyB64")) {
+            val disk = Disk(); prepare(disk.open(owner.deviceId))
+            val root = Json.parseToJsonElement(disk.text!!).jsonObject
+            val intent = root.getValue("pendingPreKeyPublication").jsonObject
+            val bundle = intent.getValue("bundle").jsonObject
+            disk.text = JsonObject(root + ("pendingPreKeyPublication" to JsonObject(intent +
+                ("bundle" to JsonObject(bundle + (field to JsonPrimitive("AQ=="))))))).toString()
+            val corrupted = disk.text
+            assertTrue(field, runCatching { disk.open(owner.deviceId).preKeyPublicationState(owner.deviceId) }.isFailure)
+            assertEquals(corrupted, disk.text)
+        }
+    }
+
+    @Test fun exhaustedCountersAndClockRollbackNeverPartiallyStage() {
+        for (ids in listOf(Triple(Int.MAX_VALUE, 1, 1), Triple(1, Int.MAX_VALUE, 1), Triple(1, 1, Int.MAX_VALUE))) {
+            val disk = Disk(); val provider = disk.open(owner.deviceId)
+            provider.publishableBundle(owner.deviceId, ids.first, ids.second, ids.third)
+            val stable = disk.text
+            assertTrue(runCatching { prepare(provider) }.isFailure)
+            assertEquals(stable, disk.text)
+        }
+        val policy = PreKeyReplenishmentPolicy()
+        assertTrue(policy.evaluate(PreKeyReplenishmentState(true, 1_800_000_000L, 1), 1_700_000_000L).clockAnomaly)
+    }
+}
diff --git a/android-wife-assistant/app/src/test/java/com/wifeassistant/PreKeyPublicationTransportTest.kt b/android-wife-assistant/app/src/test/java/com/wifeassistant/PreKeyPublicationTransportTest.kt
new file mode 100644
index 0000000..3c2292a
--- /dev/null
+++ b/android-wife-assistant/app/src/test/java/com/wifeassistant/PreKeyPublicationTransportTest.kt
@@ -0,0 +1,120 @@
+package com.wifeassistant
+
+import com.wifeassistant.data.crypto.DeviceIdentityCodec
+import com.wifeassistant.data.pairing.*
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.json.*
+import okhttp3.mockwebserver.*
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import java.net.InetAddress
+import java.util.Base64
+import java.util.concurrent.TimeUnit
+
+class PreKeyPublicationTransportTest {
+    private lateinit var server: MockWebServer
+    private val identity = DeviceIdentityCodec.generate()
+    private val now = 1_800_000_000L
+    private fun client() = DirectRelayClient(server.url("/").newBuilder().host("127.0.0.1").build().toString())
+    @Before fun setUp() { server = MockWebServer(); server.start(InetAddress.getByName("127.0.0.1"), 0) }
+    @After fun tearDown() { server.shutdown() }
+
+    private fun respond(change: (MutableMap<String, JsonElement>) -> Unit = {}) {
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest): MockResponse {
+                val body = Json.parseToJsonElement(request.body.clone().readUtf8()).jsonObject
+                val fields = mutableMapOf<String, JsonElement>(
+                    "ok" to JsonPrimitive(true), "deviceId" to JsonPrimitive(identity.deviceId),
+                    "requestNonce" to body.getValue("requestNonce"), "serverTimeEpochSec" to JsonPrimitive(now),
+                    "bundleDigest" to JsonPrimitive("a".repeat(64)), "oneTimePreKeyId" to JsonPrimitive(1),
+                    "oneTimePreKeyAvailable" to JsonPrimitive(true), "publishedAtEpochSec" to JsonPrimitive(now - 1))
+                change(fields)
+                return MockResponse().setBody(JsonObject(fields).toString())
+            }
+        }
+    }
+
+    @Test fun signedStatusBindsOwnDeviceTimestampAndFreshNonceWithoutPrivateMaterial() = runBlocking {
+        respond()
+        assertTrue(client().preKeyPublicationStatus(identity, now).getOrThrow().oneTimePreKeyAvailable)
+        val first = server.takeRequest(1, TimeUnit.SECONDS)!!
+        assertEquals("POST", first.method); assertEquals("/api/prekeys-status", first.path)
+        val body = first.body.readUtf8()
+        val payload = Json.parseToJsonElement(body).jsonObject
+        val nonce = payload.getValue("requestNonce").jsonPrimitive.content
+        assertTrue(Regex("^[0-9a-f]{32}$").matches(nonce))
+        val proof = "prekeys-status:${identity.deviceId}:$now:$nonce"
+        assertEquals(proof, DirectRelayProofs.preKeyPublicationStatus(identity.deviceId, now, nonce))
+        assertTrue(DeviceIdentityCodec.verify(identity.publicKeyB64, proof.toByteArray(),
+            Base64.getDecoder().decode(payload.getValue("signatureB64").jsonPrimitive.content)))
+        assertFalse(body.contains(identity.privateKeyB64))
+        client().preKeyPublicationStatus(identity, now).getOrThrow()
+        val again = Json.parseToJsonElement(server.takeRequest().body.readUtf8()).jsonObject
+        assertNotEquals(nonce, again.getValue("requestNonce").jsonPrimitive.content)
+    }
+
+    @Test fun emptyAndConsumedStatusesAreNonConsumingExplicitObservations() = runBlocking {
+        respond {
+            it["bundleDigest"] = JsonNull; it["oneTimePreKeyId"] = JsonNull
+            it["publishedAtEpochSec"] = JsonNull; it["oneTimePreKeyAvailable"] = JsonPrimitive(false)
+        }
+        val empty = client().preKeyPublicationStatus(identity, now).getOrThrow()
+        assertNull(empty.bundleDigest); assertFalse(empty.oneTimePreKeyAvailable)
+        respond { it["oneTimePreKeyAvailable"] = JsonPrimitive(false) }
+        val consumed = client().preKeyPublicationStatus(identity, now).getOrThrow()
+        assertEquals("a".repeat(64), consumed.bundleDigest); assertFalse(consumed.oneTimePreKeyAvailable)
+    }
+
+    @Test fun rejectsWrongDeviceNonceMalformedHashAndInconsistentStatus() = runBlocking {
+        val mutations: List<(MutableMap<String, JsonElement>) -> Unit> = listOf(
+            { it["deviceId"] = JsonPrimitive("other") },
+            { it["requestNonce"] = JsonPrimitive("0".repeat(32)) },
+            { it["bundleDigest"] = JsonPrimitive("bad digest") },
+            { it["bundleDigest"] = JsonNull },
+            { it["oneTimePreKeyId"] = JsonPrimitive(0) },
+            { it["publishedAtEpochSec"] = JsonPrimitive(now + 1) },
+            { it["publishedAtEpochSec"] = JsonNull },
+            { it.remove("bundleDigest") },
+            { it.remove("oneTimePreKeyAvailable") },
+            { it.remove("requestNonce") },
+        )
+        for (mutation in mutations) {
+            respond(mutation)
+            assertTrue(client().preKeyPublicationStatus(identity, now).isFailure)
+        }
+        assertEquals(mutations.size, server.requestCount)
+    }
+
+    @Test fun staleRequestAndInconsistentServerClockDoNotClaimSuccess() = runBlocking {
+        respond { it["serverTimeEpochSec"] = JsonPrimitive(now + 301) }
+        assertTrue(client().preKeyPublicationStatus(identity, now).exceptionOrNull() is PreKeyClockException)
+        server.dispatcher = object : Dispatcher() {
+            override fun dispatch(request: RecordedRequest) = MockResponse().setResponseCode(400)
+                .setBody("""{"ok":false,"reason":"stale timestamp"}""")
+        }
+        // Non-success responses are decoded generically before a success schema
+        // can establish any publication evidence.
+        assertEquals("stale timestamp", (client().preKeyPublicationStatus(identity, now).exceptionOrNull() as RelayRequestException).refusalReason)
+    }
+
+    @Test fun unsafeEndpointsAndInvalidClockFailBeforeNetwork() = runBlocking {
+        for (url in listOf("", "http://relay.example.test", "https://user:pass@relay.example.test",
+            "https://relay.example.test?x=1", "https://relay.example.test#x")) {
+            assertTrue(DirectRelayClient(url).preKeyPublicationStatus(identity, now).isFailure)
+        }
+        for (time in listOf(0L, -1L, Long.MAX_VALUE)) assertTrue(client().preKeyPublicationStatus(identity, time).isFailure)
+        assertEquals(0, server.requestCount)
+        assertEquals("https://relay.example.test/path", DirectRelayClient("https://RELAY.example.test:443/path/").publicationScope())
+    }
+
+    @Test fun redirectAndDisconnectedResponseAreNotSilentlyRetried() = runBlocking {
+        server.enqueue(MockResponse().setResponseCode(307).addHeader("Location", server.url("/wrong"))
+            .setBody("""{"ok":true}"""))
+        assertTrue(client().preKeyPublicationStatus(identity, now).isFailure)
+        server.enqueue(MockResponse().setSocketPolicy(SocketPolicy.DISCONNECT_AFTER_REQUEST))
+        assertTrue(client().preKeyPublicationStatus(identity, now).isFailure)
+        assertEquals(2, server.requestCount)
+    }
+}
