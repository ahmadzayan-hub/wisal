# ---- مساعد تيليجرام الشخصي — متغيّرات البيئة ----
# انسخ الملف ده إلى .env واملا القيم. ممنوع نهائياً ترفع .env على git.

# توكن البوت من @BotFather على تيليجرام (مجاني).
# الخطوات: افتح @BotFather → /newbot → اختار اسم ويوزرنيم → هياخد توكن زي ده:
#   123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# راجع خطة حسابك وحدودها قبل التفعيل: https://console.groq.com/keys
# خدمة خارجية بحصص وشروط حسب الحساب، وليست مجانية بلا حدود.
GROQ_API_KEY=

# Keep off until you verify free-plan eligibility and approve prompt data transfer.
GROQ_ENABLED=false
GROQ_MODEL=openai/gpt-oss-20b
