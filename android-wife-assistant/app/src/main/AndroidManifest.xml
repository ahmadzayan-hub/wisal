<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- الإنترنت لازم للتواصل مع Groq -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- إشعارات الصباح/المساء (أندرويد 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- قراءة تقويم الموبايل (Google Calendar وغيره) لتغذية الاقتراحات بالمناسبات -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- قراءة جهات الاتصال لاستيراد أعياد الميلاد (بموافقة المستخدم وقت الاستخدام) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- عشان نقدر نفتح واتساب بالـ intent -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WifeAssistant">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WifeAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- استقبال روابط دعوات الإقران wisal://pair#... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wisal" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- ودجت الشاشة الرئيسية: فتح سريع لشاشة الاقتراحات -->
        <receiver
            android:name=".widget.WisalWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
